{
  "name": "cascade-lab",
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node tests/smoke.mjs && node tests/modern.mjs",
    "build:githack": "vite build --outDir site",
    "measure": "node tests/measure.mjs",
    "compare": "node tests/compare.mjs",
    "test:particles": "node tests/particles.mjs",
    "test:particles:browser": "npm run build:githack && node tests/particles-browser.mjs",
    "test:formations": "node tests/formations.mjs",
    "test:formations:browser": "npm run build:githack && node tests/formations-browser.mjs",
    "test:solid-formations": "node tests/solid-formations.mjs",
    "test:solid-formations:browser": "npm run build:githack && node tests/solid-formations-browser.mjs",
    "test:routes": "node tests/formation-routes.mjs",
    "test:routes:browser": "npm run build:githack && node tests/formation-routes-browser.mjs",
    "test:placement": "node tests/formation-placement.mjs",
    "test:viewport:browser": "npm run build:githack && node tests/viewport-editor-browser.mjs",
    "test:surface": "node tests/surface-maps.mjs",
    "test:surface:browser": "npm run build:githack && node tests/surface-browser.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide": "^0.468.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^6.1.0"
  }
}
